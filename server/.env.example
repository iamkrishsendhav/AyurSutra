# Copy to .env and fill in local credentials. Never commit .env.
# Local development database. In production, configure MONGODB_URI in Render with
# the Atlas URI and an explicit production database name.
MONGODB_URI=mongodb://127.0.0.1:27017/ayursutra
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRATION=24h
PORT=5000
NODE_ENV=development
# Use a unique value of at least 32 characters in production.
SESSION_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Set MONGODB_URI to an Atlas URI with an explicit production database name.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
PRACTITIONER_PHONE=+15555550123
TWILIO_STATUS_CALLBACK_URL=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CLINIC_TIMEZONE=Asia/Kolkata
ADMIN_EMAIL=admin@example.com
# Set a unique random password of at least 6 characters; do not commit server/.env.
ADMIN_INITIAL_PASSWORD=
